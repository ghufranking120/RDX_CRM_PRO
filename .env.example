# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_ACCESS_TOKEN: Meta WhatsApp Cloud API System User access token (server-side only)
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Meta Phone Number ID (server-side only)
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Secret token configured in Meta App Webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# N8N_WEBHOOK_URL: URL of external n8n webhook trigger
N8N_WEBHOOK_URL=""

# N8N_API_KEY: Optional header key for authenticating with n8n instance
N8N_API_KEY=""
